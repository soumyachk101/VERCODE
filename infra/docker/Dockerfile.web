# ---------------------------------------------------------------------------
# VERCODE web image (DEPLOYMENT §1 "the web is a Next.js standalone build";
# §2 the multi-stage install → build → runtime rule; §3 "no secret in a
# layer").
#
# Stage 1 (deps): the pnpm workspace install (a the standalone build bundles
# the app's own node_modules into .next/standalone, but the workspace links
# must exist at build time).
# Stage 2 (build): `next build` with `output: "standalone"` (next.config.mjs
# already sets it) → a self-contained .next/standalone/server.js.
# Stage 3 (runtime): a slim runtime carrying ONLY the standalone server +
# the static assets — not the whole monorepo.
#
# NO SECRET IN A LAYER: NEXT_PUBLIC_API_BASE is a build-time *inlined* value
# (a public origin, not a secret); session keys + provider keys are deploy-
# time env on the api/worker, never in this image.
#
# Build (from the repo root):
#   docker build -f infra/docker/Dockerfile.web -t vercode/web .
# ---------------------------------------------------------------------------

# --- deps ------------------------------------------------------------------
FROM node:22-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/github/package.json packages/github/
COPY packages/diff-engine/package.json packages/diff-engine/
COPY packages/static-analysis/package.json packages/static-analysis/
COPY packages/review-engine/package.json packages/review-engine/
COPY packages/ai-providers/package.json packages/ai-providers/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile

# --- build -----------------------------------------------------------------
FROM deps AS build
COPY . .
# A the public API base the web client fetches (a build-time inline, NEXT_PUBLIC_
# *). The Compose dev-stack points it at the api service; a prod deploy sets
# its real origin. A not a secret (a it's a public URL), just a placeholder
# for builds without env.
ENV NEXT_PUBLIC_API_BASE=http://localhost:4000
RUN pnpm --filter @vercode/web build

# --- runtime ----------------------------------------------------------------
FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
# A the standalone output (a the server.js + its minimal node_modules) + the
# static/public assets that standalone doesn't carry.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
RUN useradd -m -u 10001 vercode
USER vercode
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# The standalone server expects its own tree at process.cwd()/apps/web/.next
# relative paths; run it from /app.
CMD ["node", "apps/web/server.js"]
