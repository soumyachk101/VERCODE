# ---------------------------------------------------------------------------
# VERCODE — .env.example (a the ENVIRONMENT_VARIABLES.md §10 "a the
# .env.example (a the generated artifact)" — a the config codegen's
# projection: a the var names + a the placeholders + a the one-line
# comment per var, a the groups as in the doc).
#
# THE SECRET RULE (NFR-31, SECRETS_MANAGEMENT §4): placeholders only, a
# no real secret in this file. A a committed .env with a real value is a
# CI-secret-scanner defect (a the doc's §9 rule "a a committed .env with a
# real value is a CI-secret-scanner defect"). A the deployer copies this
# to .env, fills the real values into the secret store, a the config
# package validates a the exact set at boot (a a missing/extra var is a
# startup error, not a silent default, §9 "a the config package is a the
# only reader of env").
#
# THE DEVMODE FLAGS (§7): a the Compose dev-stack runs these as "true"
# (a the mock providers — a no external credentials, a the TRD §18
# "a the dev-stack"); a live deploy flips them to "false" + provides a the
# real keys. A a deploy that's "true" is a *dev/mock* deploy — a the
# live pipeline is blocked (a the unverified-integration rule, PHASE 10).
# ---------------------------------------------------------------------------

# --- §1 Core (a the required in every deploy) ------------------------------
# a the process's env ("development" / "production" / "test").
NODE_ENV=development
# a the Postgres connection string ("postgresql://user:pass@host:5432/vercode").
DATABASE_URL=postgresql://user:pass@localhost:5432/vercode
# a the Redis connection string ("redis://localhost:6379").
REDIS_URL=redis://localhost:6379
# a the session-cookie signing key (a 64-byte base64 hex; a the `openssl rand -base64 64` placeholder, a the real value is in the secret store).
SESSION_SIGNING_KEY=<base64 hex placeholder>
# a the public API origin ("https://api.vercode.example" — a the webhooks + a the redirects).
API_BASE_URL=http://localhost:4000
# a the public web-app origin ("https://app.vercode.example" — a the dashboard).
WEB_BASE_URL=http://localhost:3000

# --- §2 GitHub App -----------------------------------------------------------
# a the GitHub App's numeric id.
GITHUB_APP_ID=123456
# a the App's PEM private key (a the KMS-wrapped value, a the real key is in the secret store, a never in the env).
GITHUB_APP_PRIVATE_KEY=<KMS-wrapped PEM placeholder>
# a the HMAC secret for a the `X-Hub-Signature-256` (a the *test* value in dev, a the *real* value in prod).
GITHUB_WEBHOOK_SECRET=test-webhook-secret-dev
# a the GitHub API base ("https://api.github.com"; a a GHE deploy overrides).
GITHUB_API_BASE=https://api.github.com

# --- §2b GitHub OAuth (the account page's per-user "Connect GitHub") -----------
# a the OAuth client id (a a GitHub *OAuth App* distinct from the GitHub App above; a placeholder only, a real id in the secret store).
GITHUB_CLIENT_ID=<github-oauth-app-client-id placeholder>
# a the OAuth client secret (a placeholder only, a real secret in the secret store).
GITHUB_CLIENT_SECRET=<github-oauth-app-client-secret placeholder>

# --- §3 AI provider ------------------------------------------------------------
# a the default provider ("openai" / "anthropic" / "ollama" / "mock" in dev).
AI_DEFAULT_PROVIDER=mock
# a the platform's OpenAI key (a the env / a the secret store, a never a DB column; a placeholder only).
OPENAI_API_KEY=<sk-... placeholder>
# a the Anthropic key (a the multi-provider, Phase 1; a placeholder only).
ANTHROPIC_API_KEY=<sk-ant-... placeholder>
# a the self-hosted Ollama endpoint (a the BYOK / a the zero-cost path).
OLLAMA_BASE_URL=http://ollama.internal:11434
# a the no-training flag (a the integration verifies against the provider's no-training classification, NFR-29).
AI_FOBID_TRAINING=true
# a the task-level fallback provider (a FR-314, a the one-switch).
AI_FALLBACK_PROVIDER=anthropic

# --- §5 Observability ---------------------------------------------------------
# a the per-process Sentry DSNs (a PII-scrubbed, TRD §15; a placeholders only).
SENTRY_DSN_API=https://...@sentry.io/...
SENTRY_DSN_WORKER=https://...@sentry.io/...
SENTRY_DSN_WEB=https://...@sentry.io/...
# a the OTel collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# a the per-process service name ("vercode-api" / "vercode-worker" / "vercode-web").
OTEL_SERVICE_NAME=vercode-api
# a the log level ("debug" / "info" / "warn" / "error"; a the redactor runs at *every* level, SECRETS_MANAGEMENT §3).
LOG_LEVEL=info

# --- §6 Quota + limits (a the platform defaults; a the org-level override is in the DB)
# a the platform-level monthly provider-spend ceiling (a the cost-abuse backstop, RATE_LIMITING §6).
PLATFORM_TOKEN_SPEND_CAP_USD=100000
# a the default confidence floor (0.6; a the org's override is in `org_settings`, not env).
DEFAULT_CONFIDENCE_FLOOR=0.6
# a the pipeline's wall-clock cap (a the default 240 s, REVIEW_ENGINE_SPEC §4).
REVIEW_WALL_CLOCK_BUDGET_MS=240000
# a the per-review budget defaults (60 files / 3000 lines, NFR-19; a the org override is in `org_settings`).
REVIEW_MAX_FILES=60
REVIEW_MAX_LINES=3000
# a the per-worker-instance concurrency (a the default 4, NFR-17).
WORKER_CONCURRENCY=4
# a the review-job retry cap (a the default 3, NFR-14).
QUEUE_MAX_ATTEMPTS=3

# --- §7 Dev-only (a the mock providers, a the Compose stack) ----------------
# a the api/worker use the mock-GitHub stub (a the Compose default; a live deploy is `false`).
USE_MOCK_GITHUB=true
# a the pipeline uses the deterministic mock provider (a the Compose default; a live deploy is `false` + a the real key).
USE_MOCK_AI=true
# --- §8 KMS ---------------------------------------------------------------------
# a the KMS endpoint + a the region (a the BYOK master key + a the App private key are wrapped under it, SECRETS_MANAGEMENT §2).
KMS_ENDPOINT=<cloud KMS endpoint placeholder>
KMS_REGION=<cloud KMS region placeholder>
# a the KMS CMK that wraps a the per-org BYOK keys.
KMS_BYOK_MASTER_KEY_ID=<CMK id placeholder>
# a the KMS CMK that wraps `GITHUB_APP_PRIVATE_KEY` at rest.
KMS_APP_KEY_KEY_ID=<CMK id placeholder>

# --- §9 Website (a the public-website surface, a the docs/WEBSITE/TECHNICAL_ARCHITECTURE.md §6) ---
# a the canonical domain (a the sitemap.xml + a the robots.txt + a the canonical + a the og:url).
VERCODE_WEBSITE_BASE_URL=https://vercode.com
# a the default OG image path (a the per-blog-slug image is a front-matter field).
VERCODE_WEBSITE_OG_DEFAULT=/og.png
# a the HMAC key for a the POST /api/track beacon (a the cookieless first-party beacon, a the WFR-504; a the real value is in a the secret store, a the NFR-31 rule).
VERCODE_BEACON_SECRET=<64-byte base64 hex placeholder>
