# VERCODE environment — placeholders only. Copy to .env and fill in real values.
# NEVER commit real secrets.

# Datastores
DATABASE_URL=postgres://set-me:set-me@localhost:5432/vercode
REDIS_URL=redis://set-me:6379

# GitHub webhook + OAuth + GitHub App
GITHUB_WEBHOOK_SECRET=set-me
GITHUB_CLIENT_ID=set-me
GITHUB_CLIENT_SECRET=set-me
GITHUB_APP_ID=set-me

# Auth (JWT signing — see apps/api/src/auth-middleware.ts for where this lives)
JWT_SECRET=set-me

# LLM providers
OPENAI_API_KEY=set-me
ANTHROPIC_API_KEY=set-me

# Billing
STRIPE_SECRET_KEY=set-me
STRIPE_WEBHOOK_SECRET=set-me

# Observability
SENTRY_DSN=set-me
