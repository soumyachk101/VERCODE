{
  "name": "vercode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "VERCODE — AI-powered code-review SaaS (monorepo root)",
  "type": "module",
  "packageManager": "pnpm@9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --filter \".\"... dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "benchmark": "tsx --tsconfig tests/tsconfig.json tests/benchmark/harness.ts",
    "benchmark:baseline": "tsx --tsconfig tests/tsconfig.json tests/benchmark/harness.ts --save-baseline",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm benchmark"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
