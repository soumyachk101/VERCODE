{
  "name": "@vercode/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercode/config": "workspace:*",
    "@vercode/contracts": "workspace:*",
    "@vercode/database": "workspace:*",
    "@vercode/github": "workspace:*",
    // M4 (T4.1/T4.2): the diff parser + deterministic rules engine.
    "@vercode/diff-engine": "workspace:*",
    "@vercode/static-analysis": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.54.0",
    "ioredis": "^5.6.0",
    "zod": "^3.23.8"
    // TODO(T5.1): the remaining M4 packages (ai-providers + review-engine,
    // T4.3/T4.4) are still in progress. When they land:
    //   "@vercode/ai-providers": "workspace:*",
    //   "@vercode/review-engine": "workspace:*",
    // and delete the local adapters in src/adapters/local.ts that stand in
    // for them (the interface seams are in src/config.ts).
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
